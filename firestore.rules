rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Products collection: public read, allow admin/store updates
    match /products/{productId} {
      allow read, write: if true;
    }

    // Orders collection: guest customers & admin order tracking
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Coupons collection: discount code verification
    match /coupons/{couponId} {
      allow read, write: if true;
    }
  }
}
