# ==============================================================================
# INSTAPRINT E-COMMERCE – ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Copy this file to `.env` and adjust the variables as required:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ADMIN PANEL CREDENTIALS (Staff Access)
# ------------------------------------------------------------------------------
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=your_secure_admin_password_here

# ------------------------------------------------------------------------------
# 2. GOOGLE CLUSTER / FIREBASE CONFIGURATION (Cloud Firestore & Storage)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_ga4_measurement_id

# ------------------------------------------------------------------------------
# 3. STORE CONTACT & HOTLINE
# ------------------------------------------------------------------------------
VITE_STORE_NAME=INSTAPRINT
VITE_STORE_PHONE=082406 38595
VITE_STORE_WHATSAPP=918240638595
VITE_STORE_EMAIL=orders@instaprintkolkata.com

# ------------------------------------------------------------------------------
# 4. WORKSHOP & STORE PICKUP LOCATION
# ------------------------------------------------------------------------------
VITE_STORE_ADDRESS=Ground Floor, Shop 106/B, Gopal Lal Tagore Rd, Joyshree, Baranagar
VITE_STORE_CITY=Kolkata
VITE_STORE_STATE=West Bengal
VITE_STORE_PINCODE=700036
VITE_STORE_HOURS_WEEKDAY=11:00 AM – 09:30 PM
VITE_STORE_HOURS_SUNDAY=12:00 PM – 08:00 PM

# ------------------------------------------------------------------------------
# 5. PAYMENT GATEWAY / UPI CONFIGURATION
# ------------------------------------------------------------------------------
VITE_UPI_ID=instaprint.kolkata@okhdfcbank
VITE_UPI_PAYEE_NAME=INSTAPRINT Studio
